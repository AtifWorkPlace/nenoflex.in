  "caching": {
    "browser_cache_ttl": 14400,
    "always_online": "on",
    "development_mode": "off"
  },
  "ddos_protection": {
    "sensitivity_level": "high",
    "rate_limiting": {
      "threshold": 100,
      "period": 60,
      "action": "challenge"
    }
  }
}
